# =================================================================
# QuanTik - Host Nginx Reverse Proxy Configuration Example
# Đặt file này trên máy chủ VPS (ví dụ: /etc/nginx/sites-available/quantik)
# và tạo symlink vào /etc/nginx/sites-enabled/
# =================================================================

# 1. Chuyển hướng HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name quantik.your-domain.com; # Thay bằng tên miền thực tế của bạn

    # Cho phép Certbot xác thực SSL
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Máy chủ HTTPS chính
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name quantik.your-domain.com; # Thay bằng tên miền thực tế của bạn

    # Đường dẫn chứng chỉ SSL (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/quantik.your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quantik.your-domain.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Cấu hình kích thước upload tối đa nếu cần
    client_max_body_size 50M;

    # Chuyển tiếp toàn bộ request đến Container Nginx (cổng 8080)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Cấu hình tối quan trọng cho Server-Sent Events (SSE) để theo dõi tiến độ Job
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
