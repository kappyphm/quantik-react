# =================================================================
# QuanTik Production Environment Configuration
# Copy this file to .env on your VPS/server:
#   cp .env-template .env
# =================================================================

# 1. API Keys & Authentication
# Lấy API key tại: https://vnstocks.com/account#api-key
VNSTOCK_API_KEY=your-vnstock-api-key

# Khóa quản trị hệ thống (dùng để truy cập /admin và trigger quét toàn sàn)
# Hãy tạo một chuỗi ngẫu nhiên dài, bí mật:
QUANTIK_ADMIN_KEY=your-long-random-secret-admin-key

# 2. Network & Reverse Proxy Settings
# Cổng web bên ngoài (mặc định 8080)
QUANTIK_WEB_PORT=8080

# Địa chỉ IP lắng nghe (0.0.0.0 để mở public, hoặc 127.0.0.1 nếu chạy sau Nginx/Traefik trên máy chủ host)
QUANTIK_BIND_IP=0.0.0.0

# BẮT BUỘC: Đặt thành true khi bạn chạy tên miền có chứng chỉ SSL/HTTPS!
# Khi true, cookie phiên làm việc sẽ được gắn cờ Secure để bảo mật.
QUANTIK_COOKIE_SECURE=false

# 3. Scheduler & Quant Timing (Múi giờ Asia/Ho_Chi_Minh)
QUANTIK_PRE_OPEN_TIME=07:00
QUANTIK_POST_CLOSE_TIME=16:20
QUANTIK_FETCH_INTERVAL_SECONDS=1.5

# Danh sách ngày lễ nghỉ giao dịch bổ sung (định dạng YYYY-MM-DD, cách nhau bằng dấu phẩy)
QUANTIK_HOLIDAYS=

# 4. Engine Optimization
# Tắt sinh ảnh Matplotlib tĩnh để tiết kiệm CPU và đĩa (mặc định false)
QUANTIK_GENERATE_IMAGES=false
